# Copy this file to .env and fill in real values before running in production.

PORT=4000

# --- Authentication ---
# JWT_SECRET signs staff login sessions — set this to a long random string
# before going live. If left unset, a default (insecure) value is used.
JWT_SECRET=

# Default admin account created automatically on first run, if none exists yet.
# Change the password after your first login — see /api/auth/change-password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# --- M-Pesa (Daraja) credentials — add these when the payment step is wired up ---
# These are the credentials your IT team confirmed can be reused from Odoo.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENV=sandbox
